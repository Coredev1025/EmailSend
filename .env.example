# Provider: brevo (recommended free for ~2K) | resend
PROVIDER=brevo

# Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on your verified CUSTOM domain (not @gmail.com)
FROM_EMAIL=hello@mail.yourdomain.com
FROM_NAME=Your Company

SUBJECT=Quick note for {{name}}

# Pace sends to stay under free daily caps and look less bursty
# Brevo free ~300/day → DELAY_MS=1200 is fine for a 300-send day
# Resend free ~100/day
DELAY_MS=1200
DAILY_CAP=300
