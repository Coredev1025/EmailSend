{
  "name": "lead-email-sender",
  "version": "1.0.0",
  "description": "Send templated emails to leads via free-tier providers (Brevo / Resend) with rate limiting and dry-run support",
  "type": "module",
  "bin": {
    "lead-email": "./src/cli.js"
  },
  "scripts": {
    "send": "node src/cli.js",
    "dry-run": "node src/cli.js --dry-run",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "email",
    "brevo",
    "resend",
    "template",
    "leads"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7"
  }
}
